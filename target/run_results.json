LIC.fct_revenue_per_order", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-16T08:49:57.879541Z", "completed_at": "2026-06-16T08:49:57.898357Z"}, {"name": "execute", "started_at": "2026-06-16T08:49:57.904301Z", "completed_at": "2026-06-16T08:49:58.474801Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.602963924407959, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c513b2-0002-52d7-0001-a3c600184246"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.fct_order_delivery_performance", "compiled": true, "compiled_code": "select \n    *,\n    datediff('day', purchase_date, estimated_delivery_date) as estimated_delivery_time,\n    datediff('day', purchase_date, customer_delivered_date) as actual_delivery_time,\n    estimated_delivery_time - actual_delivery_time as estimated_vs_actual,\n    case\n        when estimated_vs_actual > 0 then 'early'\n        when estimated_vs_actual < 0 then 'late'\n    end as punctuality_performance,\n    datediff('day', carrier_delivered_date, customer_delivered_date) as days_in_carrier_transit\nfrom OLIST_PROJECT.PUBLIC.stg_orders", "relation_name": "OLIST_PROJECT.PUBLIC.fct_order_delivery_performance", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-16T08:49:58.085303Z", "completed_at": "2026-06-16T08:49:58.096546Z"}, {"name": "execute", "started_at": "2026-06-16T08:49:58.097549Z", "completed_at": "2026-06-16T08:49:58.654162Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.5713019371032715, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c513b2-0002-5313-0001-a3c60018524e"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.fct_customer_rfm_segmentation", "compiled": true, "compiled_code": "with customer_rfm as (\nselect\n    o.customer_id,\n    max(o.approval_date) as most_recent_order,\n    count(o.order_id) as order_frequency,\n    sum(oi.price) as total_order_value\nfrom OLIST_PROJECT.PUBLIC.stg_orders o\nleft join OLIST_PROJECT.PUBLIC.stg_order_items oi on o.order_id = oi.order_id\nwhere o.order_status = 'delivered'\ngroup by o.customer_id\n)\n\nselect \n    c.customer_id,\n    c.customer_state,\n    c.customer_city,\n    crfm.most_recent_order,\n    crfm.order_frequency,\n    crfm.total_order_value\nfrom OLIST_PROJECT.PUBLIC.stg_customers c\nleft join customer_rfm crfm on c.customer_id = crfm.customer_id\norder by order_frequency, customer_id", "relation_name": "OLIST_PROJECT.PUBLIC.fct_customer_rfm_segmentation", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-16T08:49:57.875834Z", "completed_at": "2026-06-16T08:49:57.892034Z"}, {"name": "execute", "started_at": "2026-06-16T08:49:57.892034Z", "completed_at": "2026-06-16T08:49:59.081356Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 1.2105200290679932, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c513b2-0002-52d7-0001-a3c60018424a"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.fct_leakage_rate", "compiled": true, "compiled_code": "select * from OLIST_PROJECT.PUBLIC.stg_orders\nwhere approval_date is not null\nand order_status = 'canceled'\nor order_status = 'unavailable'", "relation_name": "OLIST_PROJECT.PUBLIC.fct_leakage_rate", "batch_results": null}], "elapsed_time": 8.294580936431885, "args": {"require_nested_cumulative_type_params": false, "use_fast_test_edges": false, "log_level_file": "debug", "partial_parse_file_diff": true, "quiet": false, "require_unique_project_resource_names": false, "vars": {}, "state_modified_compare_more_unrendered_values": false, "use_colors_file": true, "show_resource_report": false, "favor_state": false, "static_parser": true, "write_json": true, "profiles_dir": "C:\\Users\\SURF\\