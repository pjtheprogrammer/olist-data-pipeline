t": "2026-06-16T20:19:39.019540Z", "completed_at": "2026-06-16T20:19:40.898344Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 2.0632758140563965, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c51664-0002-5359-0001-a3c600198026"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.stg_orders", "compiled": true, "compiled_code": "select \n    order_id,\n    customer_id,\n    order_status,\n    to_timestamp_ntz(order_purchase_timestamp/1000000000) as purchase_date,\n    to_timestamp_ntz(order_approved_at/1000000000) as approval_date,\n    to_timestamp_ntz(order_delivered_carrier_date/1000000000) as carrier_delivered_date,\n    to_timestamp_ntz(order_estimated_delivery_date/1000000000) as estimated_delivery_date,\n    to_timestamp_ntz(order_delivered_customer_date/1000000000) as customer_delivered_date,\nfrom OLIST_PROJECT.PUBLIC.RAW_ORDERS", "relation_name": "OLIST_PROJECT.PUBLIC.stg_orders", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-16T20:19:40.937583Z", "completed_at": "2026-06-16T20:19:40.977654Z"}, {"name": "execute", "started_at": "2026-06-16T20:19:40.979642Z", "completed_at": "2026-06-16T20:19:41.398869Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.47092127799987793, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c51664-0002-5310-0001-a3c60019703e"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.fct_leakage_rate", "compiled": true, "compiled_code": "select * from OLIST_PROJECT.PUBLIC.stg_orders\nwhere approval_date is not null\nand order_status = 'canceled'\nor order_status = 'unavailable'", "relation_name": "OLIST_PROJECT.PUBLIC.fct_leakage_rate", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-16T20:19:40.944581Z", "completed_at": "2026-06-16T20:19:40.995476Z"}, {"name": "execute", "started_at": "2026-06-16T20:19:40.996727Z", "completed_at": "2026-06-16T20:19:41.420411Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.492504358291626, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c51664-0002-5310-0001-a3c60019703a"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.fct_order_delivery_performance", "compiled": true, "compiled_code": "select \n    *,\n    datediff('day', purchase_date, estimated_delivery_date) as estimated_delivery_time,\n    datediff('day', purchase_date, customer_delivered_date) as actual_delivery_time,\n    estimated_delivery_time - actual_delivery_time as estimated_vs_actual,\n    case\n        when estimated_vs_actual > 0 then 'early'\n        when estimated_vs_actual < 0 then 'late'\n    end as punctuality_performance,\n    datediff('day', carrier_delivered_date, customer_delivered_date) as days_in_carrier_transit\nfrom OLIST_PROJECT.PUBLIC.stg_orders", "relation_name": "OLIST_PROJECT.PUBLIC.fct_order_delivery_performance", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-16T20:19:40.967768Z", "completed_at": "2026-06-16T20:19:41.003814Z"}, {"name": "execute", "started_at": "2026-06-16T20:19:41.007102Z", "completed_at": "2026-06-16T20:19:41.484013Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.5524334907531738, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c51664-0002-5368-0001-a3c60019604a"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.fct_revenue_per_order", "compiled": true, "compiled_code": "select \n    o.order_id,\n    count(oi.order_item_id) as no_of_items,\n    sum(oi.price) as total_price,\n    sum(oi.freight_value) as freight_cost,\n    total_price + freight_cost as total_order_value\nfrom OLIST_PROJECT.PUBLIC.stg_orders o\njoin OLIST_PROJECT.PUBLIC.stg_order_items oi on o.order_id = oi.order_id\ngroup by o.order_id", "relation_name": "OLIST_PROJECT.PUBLIC.fct_revenue_per_order", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-16T20:19:40.914389Z", "completed_at": "2026-06-16T20:19:40.935654Z"}, {"name": "execute", "started_at": "2026-06-16T20:19:40.953048Z", "completed_at": "2026-06-16T20:19:42.231476Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 1.325146198272705, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c51664-0002-5310-0001-a3c600197042"}, "message": "SUCCESS 1", "failures": null, "unique_id": "model.olist_transform.fct_customer_rfm_segmentation", "compiled": true, "compiled_code": "with customer_rfm_setup as (\nselect\n    o.customer_id,\n    max(o.approval_date) as most_recent_order,\n    count(o.order_id) as order_frequency,\n    sum(oi.price) as total_order_value\nfrom OLIST_PROJECT.PUBLIC.stg_orders o\nleft join OLIST_PROJECT.PUBLIC.stg_order_items oi on o.order_id = oi.order_id\nwhere o.order_status = 'delivered' and oi.price is not null\ngroup by o.customer_id\n),\n\ncustomer_raw_rfm_records as (\nselect \n    c.customer_id,\n    c.customer_state,\n    c.customer_city,\n    crfm.most_recent_order,\n    crfm.order_frequency,\n    crfm.total_order_value\nfrom OLIST_PROJECT.PUBLIC.stg_customers c\nleft join customer_rfm_setup crfm on c.customer_id = crfm.customer_id\norder by order_frequency, customer_id\n)\n\nselect\n    customer_id,\n    6 - ntile(5) over (order by most_recent_order asc) as r_score,\n    ntile(5) over (order by order_frequency asc) as f_score,\n    ntile(5) over (order by total_order_value asc) as m_score,\n    (r_score || f_score || m_score) as rfm_score\nfrom customer_raw_rfm_records", "relation_name": "OLIST_PROJECT.PUBLIC.fct_customer_rfm_segmentation", "batch_results": null}], "elapsed_time": 9.786928415298462, "args": {"cache_selected_only": false, "use_colors_file": t